        employees.sort(function(a, b) {
            var aValue = a[columnName].trim();
            var bValue = b[columnName].trim();
            var aNum = Number(aValue.replace(/[$,]/g, ""));
            var bNum = Number(bValue.replace(/[$,]/g, ""));
            var isNumeric = !isNaN(aNum) && !isNaN(bNum);
            if (isNumeric) return aNum - bNum;
            else return aValue.localeCompare(bValue);
        });
